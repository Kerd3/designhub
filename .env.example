# ---------- Frontend (copy to frontend/.env) ----------
# mock = in-browser mock API (default, no server needed); api = Express backend
VITE_DATA_SOURCE=mock
VITE_API_BASE_URL=http://localhost:5000/api
VITE_MOCK_LATENCY_MS=350
# Never place private keys in VITE_* variables: they are bundled into public JavaScript.

# ---------- Backend (copy to backend/.env) ----------
PORT=5000
# memory = in-process demo data (resets on restart); postgres = requires DATABASE_URL
DB_DRIVER=memory
# DATABASE_URL=postgres://designhub:designhub-local-only@localhost:5432/designhub
CORS_ORIGIN=http://localhost:5173,http://localhost:4173
ALLOW_DEMO_RESET=true

# ---------- Docker Compose ----------
POSTGRES_PASSWORD=designhub-local-only
