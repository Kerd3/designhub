# Which data source the services layer talks to.
#   mock — in-browser mock REST API backed by localStorage (default, no backend needed)
#   api  — the Express backend at VITE_API_BASE_URL
VITE_DATA_SOURCE=mock

# Base URL of the Express API (used only when VITE_DATA_SOURCE=api).
VITE_API_BASE_URL=http://localhost:5000/api

# Simulated network latency for the mock API, in milliseconds.
VITE_MOCK_LATENCY_MS=350

# Never put private API keys in VITE_* variables: they are bundled into public JavaScript.
